---
import { Image } from "astro:assets";
import heroPhoto from "../assets/hero-photo.png";
import { site } from "../lib/content";

interface Props {
  class?: string;
}
const { class: className = "rounded-full" } = Astro.props;
---

<div
  class:list={[
    "group relative aspect-square w-full overflow-hidden",
    className,
  ]}
>
  <Image
    src={heroPhoto}
    alt={site.name}
    width={288}
    height={288}
    class="h-full w-full object-cover grayscale contrast-[1.05] transition duration-500 ease-in-out group-hover:scale-105 group-hover:grayscale-0"
  />
</div>
