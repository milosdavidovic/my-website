---
import "../styles/entry-c.css";
import "@fontsource-variable/archivo";
import "@fontsource-variable/jetbrains-mono";
import ThemeInit from "../components/ThemeInit.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site, hero, audiences, services, background, howIWork, contact } from "../lib/content";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{site.name} — {site.role}</title>
    <meta name="description" content={hero.subhead} />
    <ThemeInit defaultTheme="light" />
  </head>
  <body class="min-h-screen bg-bg text-fg antialiased">
    <header class="flex items-center justify-between border-b border-border px-6 py-4">
      <span class="text-sm font-semibold uppercase tracking-[0.1em]">{site.name}</span>
      <ThemeToggle />
    </header>

    <section class="mx-auto max-w-6xl border-x border-border px-0">
      <div class="grid sm:grid-cols-[19rem_1fr]">
        <div class="flex flex-col justify-between gap-8 border-b border-border p-6 sm:border-b-0 sm:border-r">
          <PhotoPlaceholder class="rounded-[2rem]" />
          <div class="font-mono text-xs uppercase tracking-wider text-muted">
            <p>{site.location}</p>
            <p class="mt-1">EU &amp; US time zones</p>
          </div>
        </div>
        <div class="p-6 sm:p-10">
          <span class="font-mono text-xs uppercase tracking-wider text-accent">
            {hero.eyebrow}
          </span>
          <h1 class="mt-5 text-4xl font-semibold leading-[1.05] tracking-tight sm:text-6xl">
            {hero.headline}
          </h1>
          <p class="mt-6 max-w-lg text-balance leading-relaxed text-muted">
            {hero.subhead}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={hero.primaryCta.href}
              class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
            >
              {hero.primaryCta.label}
            </a>
            <a
              href={hero.secondaryCta.href}
              target="_blank"
              rel="noreferrer"
              class="rounded-md border border-fg px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
            >
              {hero.secondaryCta.label}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl border-x border-t border-border px-6 py-14 sm:px-10">
      <div class="mb-10 flex items-baseline gap-3 border-b border-border pb-3">
        <span class="font-mono text-xs text-accent">01</span>
        <h2 class="text-sm font-semibold uppercase tracking-[0.1em]">What I offer</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-3 sm:gap-0">
        {
          services.map((s, i) => (
            <div
              class:list={[
                "sm:px-8",
                i !== 0 && "sm:border-l sm:border-border",
                i === 0 && "sm:pl-0",
              ]}
            >
              <h3 class="mb-2 font-medium">{s.title}</h3>
              <p class="text-sm leading-relaxed text-muted">{s.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mx-auto max-w-6xl border-x border-t border-border px-6 py-14 sm:px-10">
      <div class="mb-10 flex items-baseline gap-3 border-b border-border pb-3">
        <span class="font-mono text-xs text-accent">02</span>
        <h2 class="text-sm font-semibold uppercase tracking-[0.1em]">Who I usually work with</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-3 sm:gap-0">
        {
          audiences.map((a, i) => (
            <div
              class:list={[
                "sm:px-8",
                i !== 0 && "sm:border-l sm:border-border",
                i === 0 && "sm:pl-0",
              ]}
            >
              <h3 class="mb-2 font-medium">{a.title}</h3>
              <p class="text-sm leading-relaxed text-muted">{a.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mx-auto max-w-6xl border-x border-t border-border px-6 py-14 sm:px-10">
      <div class="mb-10 flex items-baseline gap-3 border-b border-border pb-3">
        <span class="font-mono text-xs text-accent">03</span>
        <h2 class="text-sm font-semibold uppercase tracking-[0.1em]">Background</h2>
      </div>
      <p class="mb-7 max-w-2xl leading-relaxed text-muted">{background.intro}</p>
      <ul class="divide-y divide-border">
        {
          background.items.map((item, i) => (
            <li class="py-3 text-sm leading-relaxed first:pt-0 last:pb-0">
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, "0")}</span>
                <span class="font-medium">{item.label}</span>
              </div>
              {item.long && <p class="mt-2 pl-7 text-muted">{item.long}</p>}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mx-auto max-w-6xl border-x border-t border-border px-6 py-14 sm:px-10">
      <div class="mb-10 flex items-baseline gap-3 border-b border-border pb-3">
        <span class="font-mono text-xs text-accent">04</span>
        <h2 class="text-sm font-semibold uppercase tracking-[0.1em]">How I work</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-3 sm:gap-0">
        {
          howIWork.map((h, i) => (
            <div
              class:list={[
                "sm:px-8",
                i !== 0 && "sm:border-l sm:border-border",
                i === 0 && "sm:pl-0",
              ]}
            >
              <h3 class="mb-2 font-medium">{h.title}</h3>
              <p class="text-sm leading-relaxed text-muted">{h.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mx-auto max-w-6xl border border-border px-6 py-16 sm:px-10">
      <div class="mb-10 flex items-baseline gap-3 border-b border-border pb-3">
        <span class="font-mono text-xs text-accent">05</span>
        <h2 class="text-sm font-semibold uppercase tracking-[0.1em]">Contact</h2>
      </div>
      <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-end">
        <div>
          <h3 class="text-2xl font-semibold sm:text-3xl">{contact.heading}</h3>
          <p class="mt-3 max-w-md leading-relaxed text-muted">{contact.body}</p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-3">
          <a
            href={`mailto:${site.email}`}
            class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
          >
            Email
          </a>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noreferrer"
            class="rounded-md border border-fg px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </section>

    <SiteFooter />
  </body>
</html>
