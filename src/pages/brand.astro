---
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";

const base = import.meta.env.BASE_URL;

const palette = {
  light: [
    { name: "bg", hex: "#faf9fc" },
    { name: "surface", hex: "#ffffff" },
    { name: "fg", hex: "#16151a" },
    { name: "muted", hex: "#5f5c6b" },
    { name: "accent", hex: "#7c5cf0" },
    { name: "border", hex: "#e6e4ec" },
  ],
  dark: [
    { name: "bg", hex: "#0a0a0c" },
    { name: "surface", hex: "#131317" },
    { name: "fg", hex: "#f2f1f5" },
    { name: "muted", hex: "#9a97a6" },
    { name: "accent", hex: "#a78bfa" },
    { name: "border", hex: "#26242c" },
  ],
};

const variations = [
  {
    id: "A",
    name: "Signal",
    href: `${base}a`,
    concept:
      "Closest to the cognee.ai reference you liked: centered hero, quiet grid texture, fully rounded shapes. Confident and technical-adjacent without being loud.",
    font: '"Inter Variable" for everything, "JetBrains Mono Variable" for small eyebrow/index labels.',
    shape: "Buttons and photo use the shared rounded-md / rounded-[2rem] treatment; cards stay rounded-2xl.",
    structure: "Centered single column, badge + huge headline, card grids for \"what I offer\" then \"who I usually work with.\"",
  },
  {
    id: "B",
    name: "Field Notes",
    href: `${base}b`,
    concept:
      "Editorial layout: asymmetric hero with photo beside the text, serif headlines, numbered list instead of cards. Reads as the most human and least \"tech company\" of the three.",
    font: '"Fraunces Variable" (serif) for headlines and section labels, "Inter Variable" for body copy.',
    shape: "Soft-square corners (rounded-md buttons, rounded-[2rem] photo frame) — this pairing is now the shared button/photo treatment across all four variations.",
    structure: "Left-aligned, asymmetric two-column hero, numbered list sections (what I offer, then who I usually work with) divided by hairlines.",
  },
  {
    id: "C",
    name: "Grid",
    href: `${base}c`,
    concept:
      "Strict Swiss-poster structure: boxed layout, hairline rules, numbered sections (01–05). The most structured and precise — reads as rigorous, systems-minded.",
    font: '"Archivo Variable" for everything, "JetBrains Mono Variable" for index numbers and small labels.',
    shape: "Buttons and photo use the shared rounded-md / rounded-[2rem] treatment; the grid frame, hairline rules and dividers stay sharp.",
    structure: "Bordered grid frame, photo pinned top-left, vertical rules dividing every column. Section order: what I offer, who I usually work with, background, how I work, contact.",
  },
  {
    id: "D",
    name: "Blueprint",
    href: `${base}d`,
    concept:
      "Adapted from the misc/stitch_pragmatic_technical_leadership_portfolio reference, restyled onto the shared brand palette (no shadows/blur, flat surfaces, to match the other three). Sticky nav with section anchors, competency cards with skill tags, a \"how I work / what I avoid\" comparison panel, and a condensed background list. The most \"product/IDE\" feeling of the four.",
    font: '"Hanken Grotesk Variable" for headings, "Geist Variable" for body copy, "JetBrains Mono Variable" for labels and metadata — matching the reference\'s type pairing.',
    shape: "Buttons already matched rounded-md; photo now uses the shared rounded-[2rem]. Cards and the comparison panel stay rounded-lg, 1px borders only, no shadows.",
    structure: "Fixed top nav with anchor links (Services, Who I help, Background, Process, Contact), hero with unframed photo, 3-up service cards then 3-up skill cards with tags, two-column comparison block, label/meta background list.",
  },
  {
    id: "E",
    name: "Work in progress",
    href: `${base}e`,
    concept:
      "Blank canvas, wired up with the shared brand palette, theme toggle and content source — for combining whatever's working best from A–D once one direction stands out.",
    font: '"Inter Variable" for everything, "JetBrains Mono Variable" for small labels (placeholder — not yet decided).',
    shape: "Not yet decided.",
    structure: "Not yet decided — currently just a header, theme toggle and placeholder message.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>Brand decisions</title>
  </head>
  <body class="min-h-screen bg-white text-neutral-900 antialiased">
    <main class="mx-auto max-w-3xl px-6 py-16">
      <p class="text-xs uppercase tracking-wider text-neutral-400">Internal — working document</p>
      <h1 class="mt-3 text-3xl font-semibold">Brand decisions</h1>
      <p class="mt-4 max-w-xl leading-relaxed text-neutral-600">
        This page exists so brand and design choices are written down somewhere other than
        scattered chat messages — easy to reread, comment on, and change later. Nothing here is
        precious; if a decision stops making sense, we change it and update this page.
      </p>

      <section class="mt-14">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">
          Voice &amp; tone
        </h2>
        <ul class="mt-4 space-y-2 text-sm leading-relaxed text-neutral-700">
          <li>Factual and specific over promotional. State what was built or led; let the reader draw the conclusion about skill.</li>
          <li>No superlatives ("best," "world-class," "passionate"), no exclamation points, no sales language.</li>
          <li>Short sentences. Plain words. A non-technical founder should understand every line on first read.</li>
          <li>Lead with outcomes and who it's for, not with job titles or tech-stack lists.</li>
          <li>One shared copy source (<code class="font-mono text-xs">src/lib/content.ts</code>) feeds all three variations — edit copy once, it updates everywhere.</li>
        </ul>
      </section>

      <section class="mt-12">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">
          Brand palette
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-neutral-700">
          One palette, used identically across all three layout directions — the same values in
          light mode, the same values in dark mode, everywhere. Color is a brand decision, not a
          layout decision, so it's held constant while you compare structure and type.
        </p>
        <div class="mt-5 grid gap-6 sm:grid-cols-2">
          <div>
            <p class="mb-2 text-xs uppercase tracking-wider text-neutral-400">Light</p>
            <div class="flex flex-wrap gap-3">
              {
                palette.light.map((c) => (
                  <div class="w-16">
                    <div
                      class="h-10 w-16 rounded-md border border-neutral-200"
                      style={`background-color:${c.hex}`}
                    />
                    <p class="mt-1 text-[11px] text-neutral-500">{c.name}</p>
                    <p class="font-mono text-[10px] text-neutral-400">{c.hex}</p>
                  </div>
                ))
              }
            </div>
          </div>
          <div>
            <p class="mb-2 text-xs uppercase tracking-wider text-neutral-400">Dark</p>
            <div class="flex flex-wrap gap-3">
              {
                palette.dark.map((c) => (
                  <div class="w-16">
                    <div
                      class="h-10 w-16 rounded-md border border-neutral-200"
                      style={`background-color:${c.hex}`}
                    />
                    <p class="mt-1 text-[11px] text-neutral-500">{c.name}</p>
                    <p class="font-mono text-[10px] text-neutral-400">{c.hex}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-neutral-700">
          Accent is violet — picked for its tie back to the cognee.ai reference. Defined once per
          variation's CSS file but with identical values everywhere, so changing the brand color
          later means editing the same six values in three files, not redesigning anything.
        </p>
      </section>

      <section class="mt-12">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">
          Photo treatment
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-neutral-700">
          Currently showing the example photo you provided, cropped to a head-and-shoulders
          portrait and desaturated to grayscale, so it reads as designed rather than like a raw
          headshot dropped onto the page — and so the tone holds regardless of which accent color
          is live. Each variation clips it to its own shape language (circle / soft-square / sharp
          square). Swap <code class="font-mono text-xs">src/assets/hero-photo.png</code> for a
          different or final photo any time (PNG, background removed) — same crop proportions
          (roughly square, framed on the face) will carry over cleanly. No border/background frame
          around the photo anywhere now — just the image, clipped to each variation's shape. It
          fades from grayscale to full color on hover — a small, quiet detail rather than a stated
          claim, in keeping with the "qualities inferred, not stated" brief.
        </p>
      </section>

      <section class="mt-12">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">
          Theme switching
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-neutral-700">
          Each variation has a genuine default (dark for A, light for B and C) that reflects its
          concept, plus a toggle. The choice is remembered in the browser (localStorage), shared
          across all three pages — so once a reader picks light or dark, it stays that way as they
          click between variations.
        </p>
      </section>

      <section class="mt-14 border-t border-neutral-200 pt-12">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">
          The three directions — layout &amp; type only
        </h2>

        <div class="mt-6 space-y-10">
          {
            variations.map((v) => (
              <div>
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="text-lg font-semibold">
                    {v.id} — {v.name}
                  </h3>
                  <a
                    href={v.href}
                    class="text-sm text-neutral-500 underline underline-offset-4 hover:text-neutral-900"
                  >
                    view live →
                  </a>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-neutral-600">{v.concept}</p>

                <dl class="mt-4 grid gap-x-6 gap-y-1 text-sm text-neutral-600 sm:grid-cols-[6rem_1fr]">
                  <dt class="text-neutral-400">Structure</dt>
                  <dd>{v.structure}</dd>
                  <dt class="text-neutral-400">Type</dt>
                  <dd>{v.font}</dd>
                  <dt class="text-neutral-400">Shape</dt>
                  <dd>{v.shape}</dd>
                </dl>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-14 border-t border-neutral-200 pt-12">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">Open items</h2>
        <ul class="mt-4 space-y-2 text-sm leading-relaxed text-neutral-700">
          <li>Confirm the current photo is the one to keep, or swap in a different one.</li>
          <li>Confirm exact LinkedIn profile URL — placeholder is in <code class="font-mono text-xs">src/lib/content.ts</code>.</li>
          <li>Pick one variation to take forward; the other two and this page get removed before the site goes live.</li>
          <li>Domain + deploy target, once a direction is picked.</li>
        </ul>
      </section>
    </main>
  </body>
</html>
