---
import "../styles/entry-e.css";
import "@fontsource-variable/geist";
import "@fontsource-variable/hanken-grotesk";
import "@fontsource-variable/jetbrains-mono";
import ThemeInit from "../components/ThemeInit.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { site, hero, audiences, services, background, howIWork, contact, nav } from "../lib/content";

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{site.name} — {site.role} (E, work in progress)</title>
    <meta name="description" content={hero.subhead} />
    <ThemeInit defaultTheme="dark" />
  </head>
  <body class="min-h-screen bg-bg font-sans text-fg antialiased">
    <header class="glass-nav fixed inset-x-0 top-0 z-50 border-b border-border">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <span class="font-display text-lg font-bold tracking-tight">{site.name}</span>
        <nav class="hidden items-center gap-1 sm:flex">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="rounded-md px-3 py-1.5 text-sm text-muted transition-colors hover:bg-surface hover:text-fg"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main class="pt-16">
      <section class="relative mx-auto max-w-5xl overflow-hidden px-6 py-20 sm:py-28">
        <div class="grid-texture pointer-events-none absolute inset-0 -z-10 opacity-50"></div>
        <div class="grid gap-12 sm:grid-cols-12 sm:items-center">
          <div class="sm:col-span-7">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">
              {hero.eyebrow}
            </span>
            <h1 class="mt-5 font-display text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl">
              {hero.headlineGreeting} I'm <span class="text-accent">{hero.headlineName}</span>,{" "}
              {hero.headlineWords[0]} {hero.headlineSuffix}
            </h1>
            <p class="mt-6 max-w-lg leading-relaxed text-muted">{hero.subhead}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href={hero.primaryCta.href}
                class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
              >
                {hero.primaryCta.label}
              </a>
              <a
                href={hero.secondaryCta.href}
                target="_blank"
                rel="noreferrer"
                class="rounded-md border border-border px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent"
              >
                {hero.secondaryCta.label}
              </a>
            </div>
            <div class="mt-8 font-mono text-[11px] uppercase tracking-wider text-muted">
              <p>{site.location}</p>
              <p class="mt-1">EU &amp; US time zones</p>
            </div>
          </div>
          <div class="sm:col-span-5">
            <div class="mx-auto w-44 sm:mx-0 sm:ml-auto sm:w-56">
              <PhotoPlaceholder class="rounded-[2rem]" />
            </div>
          </div>
        </div>
      </section>

      <section id="services" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-12">
        <div class="mb-10 flex items-baseline gap-3 border-b border-border pb-3">
          <span class="font-mono text-xs text-accent">01</span>
          <h2 class="text-sm font-semibold uppercase tracking-[0.1em]">What I offer</h2>
        </div>
        <div data-reveal class="reveal-group grid gap-5 sm:grid-cols-3">
          {
            services.map((s, i) => (
              <div class="reveal-item rounded-lg border border-border bg-surface p-6" style={`--reveal-i: ${i}`}>
                <h3 class="mb-2 font-medium">{s.title}</h3>
                <p class="text-sm leading-relaxed text-muted">{s.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section id="work" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-12">
        <div class="mb-10 flex items-baseline gap-3 border-b border-border pb-3">
          <span class="font-mono text-xs text-accent">02</span>
          <h2 class="text-sm font-semibold uppercase tracking-[0.1em]">Who I usually work with</h2>
        </div>
        <div data-reveal class="reveal-group grid gap-5 sm:grid-cols-3">
          {
            audiences.map((a, i) => (
              <div class="reveal-item rounded-lg border border-border bg-surface p-6" style={`--reveal-i: ${i}`}>
                <h3 class="mb-2 font-medium">{a.title}</h3>
                <p class="text-sm leading-relaxed text-muted">{a.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section id="background" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-12">
        <div class="mb-10 flex items-baseline gap-3 border-b border-border pb-3">
          <span class="font-mono text-xs text-accent">03</span>
          <h2 class="text-sm font-semibold uppercase tracking-[0.1em]">Background</h2>
        </div>
        <p class="mb-7 max-w-2xl leading-relaxed text-muted">{background.intro}</p>
        <ol data-reveal class="reveal-group relative border-l border-border pl-8">
          {
            background.items.map((item, i) => (
              <li class:list={["reveal-item relative", i !== 0 && "mt-8"]} style={`--reveal-i: ${i}`}>
                <span class="absolute -left-[37px] top-1.5 h-[11px] w-[11px] rounded-full border-2 border-accent bg-bg" />
                <span class="text-sm font-medium">{item.label}</span>
                {item.long && <p class="mt-1 text-sm leading-relaxed text-muted">{item.long}</p>}
              </li>
            ))
          }
        </ol>
      </section>

      <section id="process" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-12">
        <div class="mb-10 flex items-baseline gap-3 border-b border-border pb-3">
          <span class="font-mono text-xs text-accent">04</span>
          <h2 class="text-sm font-semibold uppercase tracking-[0.1em]">How I work</h2>
        </div>
        <div data-reveal class="reveal-group grid gap-5 sm:grid-cols-3">
          {
            howIWork.map((h, i) => (
              <div class="reveal-item rounded-lg border border-border bg-surface p-6" style={`--reveal-i: ${i}`}>
                <h3 class="mb-2 font-medium">{h.title}</h3>
                <p class="text-sm leading-relaxed text-muted">{h.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section id="contact" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-12">
        <div class="mb-10 flex items-baseline gap-3 border-b border-border pb-3">
          <span class="font-mono text-xs text-accent">05</span>
          <h2 class="text-sm font-semibold uppercase tracking-[0.1em]">Contact</h2>
        </div>
        <div data-reveal class="reveal-group flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-end">
          <div class="reveal-item" style="--reveal-i: 0">
            <h3 class="text-2xl font-semibold sm:text-3xl">{contact.heading}</h3>
            <p class="mt-3 max-w-md leading-relaxed text-muted">{contact.body}</p>
          </div>
          <div class="reveal-item flex shrink-0 flex-wrap items-center gap-3" style="--reveal-i: 1">
            <a
              href={`mailto:${site.email}`}
              class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
            >
              Email
            </a>
            <a
              href={site.linkedin}
              target="_blank"
              rel="noreferrer"
              class="rounded-md border border-border px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />

    <ScrollReveal />

    <style>
      .glass-nav {
        background-color: rgba(var(--surface-rgb), 0.65);
        backdrop-filter: blur(16px) saturate(160%);
        -webkit-backdrop-filter: blur(16px) saturate(160%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
      }

      .grid-texture {
        background-image:
          linear-gradient(to right, var(--border) 1px, transparent 1px),
          linear-gradient(to bottom, var(--border) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: radial-gradient(ellipse 70% 55% at 50% 20%, black 30%, transparent 100%);
      }

      .reveal-item {
        opacity: 0;
        transform: translateY(10px);
        transition:
          opacity 0.5s ease-out,
          transform 0.5s ease-out;
      }
      .reveal-group.is-revealed .reveal-item {
        opacity: 1;
        transform: translateY(0);
        transition-delay: calc(var(--reveal-i, 0) * 90ms);
      }
    </style>
  </body>
</html>
