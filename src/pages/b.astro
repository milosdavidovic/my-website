---
import "../styles/entry-b.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/jetbrains-mono";
import ThemeInit from "../components/ThemeInit.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site, hero, audiences, services, background, howIWork, contact } from "../lib/content";

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{site.name} — {site.role}</title>
    <meta name="description" content={hero.subhead} />
    <ThemeInit defaultTheme="light" />
  </head>
  <body class="min-h-screen bg-bg text-fg antialiased">
    <header class="mx-auto flex max-w-5xl items-center justify-between px-6 py-6">
      <span class="font-serif text-lg" style="font-family: var(--font-serif);">
        {site.name}
      </span>
      <ThemeToggle />
    </header>

    <section class="mx-auto max-w-5xl px-6 pb-16 pt-6 sm:pt-12">
      <div class="grid items-center gap-10 sm:grid-cols-[1.2fr_0.8fr] sm:gap-14">
        <div class="order-2 sm:order-1">
          <span class="text-xs uppercase tracking-[0.15em] text-muted">{hero.eyebrow}</span>
          <h1
            class="mt-5 text-4xl leading-[1.1] tracking-tight sm:text-5xl"
            style="font-family: var(--font-serif); font-weight: 480;"
          >
            {hero.headline}
          </h1>
          <p class="mt-6 max-w-md text-balance leading-relaxed text-muted">
            {hero.subhead}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={hero.primaryCta.href}
              class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
            >
              {hero.primaryCta.label}
            </a>
            <a
              href={hero.secondaryCta.href}
              target="_blank"
              rel="noreferrer"
              class="rounded-md border border-border px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent"
            >
              {hero.secondaryCta.label}
            </a>
          </div>
          <p class="mt-8 text-xs uppercase tracking-[0.15em] text-muted">
            {site.location} — working with EU &amp; US teams
          </p>
        </div>
        <div class="order-1 flex justify-center sm:order-2 sm:justify-end">
          <div class="w-40 sm:w-52">
            <PhotoPlaceholder class="rounded-[2rem]" />
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-border">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <h2
          class="mb-10 text-sm uppercase tracking-[0.15em] text-muted"
          style="font-family: var(--font-serif);"
        >
          What I offer
        </h2>
        <div class="divide-y divide-border">
          {
            services.map((s, i) => (
              <div class="grid grid-cols-[3rem_1fr] gap-4 py-6 first:pt-0 last:pb-0">
                <span
                  class="text-2xl text-muted"
                  style="font-family: var(--font-serif);"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="mb-1.5 font-medium">{s.title}</h3>
                  <p class="text-sm leading-relaxed text-muted">{s.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-t border-border">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <h2
          class="mb-10 text-sm uppercase tracking-[0.15em] text-muted"
          style="font-family: var(--font-serif);"
        >
          Who I usually work with
        </h2>
        <div class="divide-y divide-border">
          {
            audiences.map((a, i) => (
              <div class="grid grid-cols-[3rem_1fr] gap-4 py-6 first:pt-0 last:pb-0">
                <span
                  class="text-2xl text-muted"
                  style="font-family: var(--font-serif);"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="mb-1.5 font-medium">{a.title}</h3>
                  <p class="text-sm leading-relaxed text-muted">{a.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-t border-border">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <h2
          class="mb-5 text-sm uppercase tracking-[0.15em] text-muted"
          style="font-family: var(--font-serif);"
        >
          Background
        </h2>
        <p class="mb-7 max-w-2xl text-balance leading-relaxed" style="font-family: var(--font-serif); font-weight: 400; font-size: 1.15rem;">
          {background.intro}
        </p>
        <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {
            background.items.map((item) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" />
                <span>{item.long ?? `${item.label} — ${item.meta}`}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="border-t border-border">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <h2
          class="mb-10 text-sm uppercase tracking-[0.15em] text-muted"
          style="font-family: var(--font-serif);"
        >
          How I work
        </h2>
        <div class="grid gap-8 sm:grid-cols-3">
          {
            howIWork.map((h) => (
              <div class="border-t border-border pt-4">
                <h3 class="mb-2 font-medium">{h.title}</h3>
                <p class="text-sm leading-relaxed text-muted">{h.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-t border-border bg-surface">
      <div class="mx-auto max-w-3xl px-6 py-20 text-center">
        <h2 class="text-3xl" style="font-family: var(--font-serif); font-weight: 480;">
          {contact.heading}
        </h2>
        <p class="mx-auto mt-3 max-w-md leading-relaxed text-muted">{contact.body}</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href={`mailto:${site.email}`}
            class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
          >
            Email
          </a>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noreferrer"
            class="rounded-md border border-border px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </section>

    <SiteFooter />
  </body>
</html>
